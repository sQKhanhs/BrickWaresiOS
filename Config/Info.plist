<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the Xcode-generated Info.plist (GENERATE_INFOPLIST_FILE = YES); holds only the keys
     that have no INFOPLIST_KEY_ build setting. Lives outside the synchronized BrickWares/ folder so it
     is not also copied as a resource. -->
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.senniapp.brickwares.retirement-check</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Allows cleartext HTTP only to loopback / .local / private-IP ranges (never public hosts), so the
	     `BrickWares Dev` build can reach the local Supabase stack at http://127.0.0.1:54321 (or the Mac's
	     LAN IP on a physical device). Prod talks to a public HTTPS host, which this does not weaken; unlike
	     NSAllowsArbitraryLoads it needs no App Store justification. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
